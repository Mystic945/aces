# Copy to frontend/.env (gitignored) and adjust. Every value is optional.

# Set to false to never call the API and run on the dataset bundled with the
# app. Used when the frontend is deployed on its own, without a backend.
VITE_USE_API=true

# Base URL of the listings API. Leave empty to call /api on the same origin
# (the Vite dev proxy locally). Set it when the backend is hosted somewhere
# else, e.g. VITE_API_BASE_URL=https://lendmatch-api.example.com
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during local development.
VITE_DEV_API_TARGET=http://localhost:4000
