# Copy to frontend/.env (gitignored) and adjust. Every value is optional.

# Base URL of the listings API. Leave empty to call /api on the same origin
# (the Vite dev proxy locally, the serverless function on Vercel).
# Set it when the Express backend is hosted somewhere else, e.g.
# VITE_API_BASE_URL=https://lendmatch-api.example.com
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during local development.
VITE_DEV_API_TARGET=http://localhost:4000
