# Copy to backend/.env (gitignored) and adjust.

# MongoDB Atlas connection string: Atlas > Database > Connect > Drivers.
# Leave it unset to serve listings from backend/data/borrower_listings.json.
# This is a secret: keep it in .env and in your host's environment variables,
# never in the frontend and never in git.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database and collection that hold the listings.
MONGODB_DB=lendmatch
MONGODB_COLLECTION=listings

# Port the Express API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API.
# Leave empty to allow any origin (fine for local development).
CORS_ORIGIN=http://localhost:5173
