{
  "name": "lendmatch-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LendMatch API: serves the open borrower listings from MongoDB Atlas",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
